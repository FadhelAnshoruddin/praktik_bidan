APP_NAME="Praktik Bidan Mila"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_STORE=file

# ---------------------------------------------------------------
# Database — MySQL lokal (development)
# Untuk cloud database, ganti dengan kredensial Aiven/penyedia lain
# ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pendaftaran_bidan
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE="+07:00"

# SSL CA Certificate — diperlukan untuk Aiven MySQL (production)
# Kosongkan untuk MySQL lokal
MYSQL_ATTR_SSL_CA=

# ---------------------------------------------------------------
# Session
# SESSION_DRIVER=database — tabel 'sessions' harus tersedia di DB
# ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------
# Enkripsi Data Pasien (WAJIB — JANGAN UBAH jika ada data lama)
# Generate kunci baru:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# ---------------------------------------------------------------
DATA_ENCRYPTION_KEY=